# ============================================================================
# Project specific
# ============================================================================
# Keep only configuration files and documentation
# Exclude all generated artifacts

# Config files to keep (versioned)
!config/*.yaml
!config/*.yml
!config/*.json

# Documentation to keep
!doc/*.md
doc/*.pdf

# Scripts to keep
!src/**/*.py
!dags/**/*.py
!tests/**/*.py


# ============================================================================
# Data files (versioned structure)
# ============================================================================
# Raw data (never commit)
data/*raw*/*
!data/*raw*/.gitkeep
!data/*raw*/README.md

# Processed data (commit only configs, not data)
data/*processed*/*
!data/*processed*/.gitkeep
!data/*processed*/*/
data/*processed*/*/*.parquet
data/*processed*/*/*.csv

# Staging data
data/staging/*
!data/staging/.gitkeep

# Output artifacts (plots, reports, evaluations)
data/output/*
!data/output/.gitkeep

# Data splits
data/*splits*/*
!data/*splits*/.gitkeep

# ============================================================================
# Experiment configurations (local tests)
# ============================================================================
# config/experiments_curated
config/pipeline_config.yaml.backup

# ============================================================================
# ML Models and artifacts
# ============================================================================
models/
output**/

# MLflow tracking
mlruns/
mlartifacts/

# ============================================================================
# Reports and outputs
# ============================================================================
reports/
outputs/
shock_output/

# Private keys / credentials (never commit)
*.pem
*.key

# Keep report generator source code
!src/reports/
!src/reports/**

# ============================================================================
# Airflow
